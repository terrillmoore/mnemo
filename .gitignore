# Binaries
mnemo
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
*_test

# Output of the go coverage tool
*.out
coverage.html

# Backup files
*.backup

# Go workspace file
go.work

# What the GitLab pipeline leaves in the working tree: the module and build
# caches it keeps between runs, and the build's own outputs. They have to be
# ignored, not merely untracked: Go stamps a build from `git status`, so an
# untracked file makes the binary say -dirty and the provenance of what the
# archive host runs stops meaning anything.
/.go/
/.gocache/
/mnemo.sha256
/build.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Video assets (too large for git, store separately)
assets/video/*.mp4
assets/video/*.webm
assets/video/*.mkv

# Database
*.db
*.db-journal

# Local config
.env
.env.local
.omc/
.nano-banana-config.json

# Local docs
docs/audit
